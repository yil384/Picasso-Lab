0015: collect_block's search spares a lit nether portal frame's corners too (0014 spared the obsidian with a portal
block on a face; a corner touches the portal only at an edge): an obsidian block with a portal block on any of the
26 cells around it. A production game (2026-10-14, gd7540a) took the 4 corner blocks of another player's lit frame,
and the next calls went back there for "the obsidian deposit". With a test (collect-block).

diff --git a/src/actions/collect-block/collect-block.test.ts b/src/actions/collect-block/collect-block.test.ts
--- a/src/actions/collect-block/collect-block.test.ts
+++ b/src/actions/collect-block/collect-block.test.ts
@@ -207,6 +207,8 @@ test("Patched for Muse plays Minecraft (picasso-lab), 0014: obsidian touching a
   const bot = { blockAt: (v: Vec3) => ({ name: portal.has(`${v.x},${v.y},${v.z}`) ? "nether_portal" : "air" }) } as unknown as Pick<Bot, "blockAt">;
   assert.equal(inLitPortalFrame(bot, { x: 0, y: 66, z: 0 }), true, "a side of the frame");
   assert.equal(inLitPortalFrame(bot, { x: 1, y: 64, z: 0 }), true, "the bottom");
-  assert.equal(inLitPortalFrame(bot, { x: 0, y: 64, z: 0 }), false, "a corner touches no portal block");
+  assert.equal(inLitPortalFrame(bot, { x: 0, y: 64, z: 0 }), true, "0015: a corner, at an edge of the portal");
+  assert.equal(inLitPortalFrame(bot, { x: 3, y: 68, z: 0 }), true, "0015: the other corner");
+  assert.equal(inLitPortalFrame(bot, { x: -1, y: 66, z: 0 }), false, "a block beside the frame");
   assert.equal(inLitPortalFrame(bot, { x: 10, y: 64, z: 10 }), false, "obsidian elsewhere");
 });
diff --git a/src/actions/collect-block/collect-block.ts b/src/actions/collect-block/collect-block.ts
