# Copy to .env next to compose.yaml and fill in. Never commit the real .env.
# Generate each secret with:  openssl rand -base64 48
GAMES_SECRET=
IP_SALT=

# off | on  (turn on only after the Firebase console steps in README.md)
EMAIL_LINK=off
FIREBASE_PROJECT_ID=yichen-5e23e

# the page origin (GitHub Pages); comma-separated list
ALLOWED_ORIGINS=https://yil384.github.io

# 1 behind Caddy: the client address is the right-most X-Forwarded-For entry
TRUST_PROXY=1

# fixed inside the container; listed for completeness
PORT=8787
DATA_DIR=/data
