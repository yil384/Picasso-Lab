+test("a cell a mob is in is not chosen for a placement", () => {
+  const { bot, bat } = cave();
+  const first = chooseCell(bot, "crafting_table", 3);
+  assert.ok(first);
+  bat(first.position);
+  const other = chooseCell(bot, "crafting_table", 3);
+  assert.ok(other, "another clear cell");
+  assert.notEqual(key(other.position), key(first.position));
+  assert.equal(other.position.distanceTo(first.position) > 0, true);
+});
+
+test("a mob that moves into the chosen cell sends the table to the next cell", async () => {
+  const { bot, placed, bat, ticks } = cave();
+  const tried: string[] = [];
+  const place = (async (_bot: Bot, p: Placement) => {
+    const cell = p.expectedCells[0];
+    tried.push(key(cell));
+    if (tried.length === 1) {
+      bat(new Vec3(cell.x, cell.y, cell.z)); // the bat arrives between the choice and the placement
+      return { kind: "failed", error: `Placement cell (${cell.x}, ${cell.y}, ${cell.z}) overlaps bat #44444 at (${cell.x + 0.5}, ${cell.y + 0.1}, ${cell.z + 0.5}).` };
+    }
+    placed.set(key(cell), "crafting_table");
+    return { kind: "placed", block: bot.blockAt(new Vec3(cell.x, cell.y, cell.z))! };
+  }) as typeof placeBlock;
+  const result = await placeCarriedBlockNearby(bot, "crafting_table", { place });
+  assert.equal(result.kind, "placed");
+  assert.equal(tried.length, 2);
+  assert.notEqual(tried[1], tried[0], "not the bat's cell again");
+  assert.equal(result.kind === "placed" && key(result.position), tried[1]);
+  assert.ok(ticks() > 0, "a short pause before the next try");
+});
+
+test("a mob in the way of every try ends with the last refusal; other refusals are not tried again", async () => {
+  const { bot, bat } = cave();
+  let calls = 0;
+  const always = (async (_bot: Bot, p: Placement) => {
+    const cell = p.expectedCells[0];
+    calls += 1;
+    bat(new Vec3(cell.x, cell.y, cell.z), 100 + calls);
+    return { kind: "failed", error: `Placement cell (${cell.x}, ${cell.y}, ${cell.z}) overlaps bat #${100 + calls} at (0, 0, 0).` };
+  }) as typeof placeBlock;
+  const crowded = await placeCarriedBlockNearby(bot, "crafting_table", { place: always });
+  assert.equal(crowded.kind, "failed");
+  assert.equal(calls, OCCUPIED_CELL_TRIES);
+  assert.match(crowded.kind === "failed" ? crowded.error : "", /overlaps bat #103/);
+
+  const { bot: plain } = cave();
+  let once = 0;
+  const refused = (async () => { once += 1; return { kind: "failed", error: "The expected block did not appear after placement." }; }) as typeof placeBlock;
+  const r = await placeCarriedBlockNearby(plain, "crafting_table", { place: refused });
+  assert.equal(r.kind, "failed");
+  assert.equal(once, 1, "a refusal with nobody in the cell is reported as before");
+});
