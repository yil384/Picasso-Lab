+/**
+ * Patched for Muse plays Minecraft (picasso-lab). Staging soak, 8 games at
+ * once, run 8: in a cave a bat flew into the cell chosen for the iron
+ * pickaxe's temporary table, and the craft failed in 1.3 s ("crafting_table:
+ * Placement cell (3, 51, 6322) overlaps bat #44444"). A cell a mob is in is
+ * not chosen, and a mob that moves into the chosen cell before the block goes
+ * down sends the placement to the next cell.
+ */
+type Placement = Parameters<typeof placeBlock>[1];
+const key = (p: { x: number; y: number; z: number }) => `${p.x},${p.y},${p.z}`;
+
+function cave() {
+  const placed = new Map<string, string>();
+  const entities: Record<number, unknown> = {};
+  let ticks = 0;
+  const bot = {
+    entity: { id: 1, position: new Vec3(0.5, 64, 0.5) },
+    entities,
+    registry: { entitiesByName: { bat: { metadataKeys: ["mob_flags"] } } },
+    inventory: { items: () => [{ name: "crafting_table", count: 1 }] },
+    blockAt: (position: Vec3) => {
+      const name = placed.get(key(position)) ?? (position.y < 64 ? "grass_block" : "air");
+      return { name, position, boundingBox: name === "air" ? "empty" : "block" };
+    },
+    waitForTicks: async (n: number) => { ticks += n; },
+  } as unknown as Bot;
+  const bat = (cell: Vec3, id = 44444) => {
+    entities[id] = { id, name: "bat", type: "mob", isValid: true, position: new Vec3(cell.x + 0.5, cell.y + 0.1, cell.z + 0.5), width: 0.5, height: 0.9 };
+  };
+  return { bot, placed, bat, ticks: () => ticks };
+}
