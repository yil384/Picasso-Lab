+/**
+ * Patched for Muse plays Minecraft (picasso-lab), 0010. A 1x1 shelter around
+ * the bot (four walls two high and a roof) asked for in a 1x2 pocket in stone,
+ * after mining: every placement read as sealing the bot in, the step-out route
+ * completed where the bot stood, and the loop asked again forever without
+ * yielding, until the supervisor's watchdog ended the runtime. A bot the world
+ * already walls in is not sealed in further by a placement, so it builds.
+ */
+test("a shelter around a bot the world already walls in (a pocket in stone) is dug out and built, the bot inside", async () => {
+  const feet = new Vec3(1, 64, 1);
+  const { bot, put, physics, routes } = structureWorld({ feet });
+  for (let x = -6; x <= 8; x += 1)
+    for (let y = 63; y <= 70; y += 1) for (let z = -6; z <= 8; z += 1) put(new Vec3(x, y, z), "stone");
+  put(new Vec3(1, 64, 1), "air");
+  put(new Vec3(1, 65, 1), "air");
+  const shelter = cells([
+    [0, 64, 1], [2, 64, 1], [1, 64, 0], [1, 64, 2],
+    [0, 65, 1], [2, 65, 1], [1, 65, 0], [1, 65, 2],
+    [1, 66, 0], [1, 66, 1],
+  ]);
+  const inside = cells([[1, 64, 1], [1, 65, 1]], "air");
+  const result = await build(bot, { ...physics, cells: [...shelter, ...inside], removeWrongBlocks: true });
+  assert.equal(result.status, "complete", result.reason ?? "");
+  assert.equal(result.placed, 10);
+  assert.equal(result.dug, 10, "the stone of every cell, replaced");
+  assert.deepEqual(routes, [], "no way out was asked for");
+});
+
+test("a shelter that asks for the bot's own cells to be air is built around the bot on open ground, the bot inside", async () => {
+  const feet = new Vec3(1, 64, 1);
+  const { bot, physics, routes } = structureWorld({ feet });
+  const shelter = cells([
+    [0, 64, 1], [2, 64, 1], [1, 64, 0], [1, 64, 2],
+    [0, 65, 1], [2, 65, 1], [1, 65, 0], [1, 65, 2],
+    [1, 66, 0], [1, 66, 1],
+  ]);
+  const result = await build(bot, { ...physics, cells: [...shelter, ...cells([[1, 64, 1], [1, 65, 1]], "air")], removeWrongBlocks: true });
+  assert.equal(result.status, "complete", result.reason ?? "");
+  assert.equal(result.placed, 10);
+  assert.deepEqual(routes, [], "it never had to step out");
+  assert.deepEqual(bot.entity.position.floored().toArray(), [1, 64, 1], "the bot is inside");
+});
+
+test("routes out that leave the bot held by the structure stop the run with the reason, and the event loop runs meanwhile", async () => {
+  const feet = new Vec3(1, 64, 1);
+  const { bot, physics } = structureWorld({ feet });
+  let routesAsked = 0;
+  // the route's goal is met where the bot stands: it completes without a step
+  const stay: BuildRequest["route"] = async () => {
+    routesAsked += 1;
+    return { status: "completed", elapsedMs: 0 };
+  };
+  let timerRan = false;
+  setImmediate(() => {
+    timerRan = true;
+  });
+  const result = await build(bot, { ...physics, route: stay, cells: cells(hollowBox()), removeWrongBlocks: false });
+  assert.equal(result.status, "stopped");
+  assert.match(result.reason ?? "", /^could not step out of the structure: 3 routes out ended at 1,64,1 with the bot still held by it$/);
+  assert.equal(routesAsked, 3);
+  assert.equal(result.placed, hollowBox().length - 1, "every block but the one that would seal it in");
+  assert.ok(timerRan, "the loop yielded between its passes");
+});
+
