diff --git a/src/survival/reflexes/hunger.test.ts b/src/survival/reflexes/hunger.test.ts
index 4ae75c3..01dee73 100644
--- a/src/survival/reflexes/hunger.test.ts
+++ b/src/survival/reflexes/hunger.test.ts
@@ -166,3 +166,50 @@ test("revoking raw food releases the active bite without waiting for its native
     await driver[Symbol.asyncDispose]();
   }
 });
+
+test("muse patch 0012: food.reflex starving eats only at hunger 4, never stays quiet", async () => {
+  let foodReads = 0;
+  const bot = Object.assign(new EventEmitter(), {
+    health: 12,
+    food: 10,
+    inventory: {
+      items: () => {
+        foodReads += 1;
+        return [];
+      },
+    },
+  }) as unknown as Bot;
+  const driver = new ReflexDriver(bot, new ActionRunner());
+  const policy = new SurvivalPolicyState(bot);
+  const reflex = attachHungerReflex(bot, driver, { activeEngagement: () => null }, policy);
+  const check = () => {
+    for (let tick = 0; tick < 20; tick += 1) bot.emit("physicsTick");
+  };
+  try {
+    await policy.edit({
+      operation: "set",
+      expected_revision: policy.snapshot().revision,
+      changes: { food: { reflex: "starving" } },
+      lifetime: { kind: "session" },
+      reason: "test",
+    } as never);
+    check();
+    assert.equal(foodReads, 0, "hunger 10 is left to the player");
+    bot.food = 4;
+    check();
+    assert.equal(foodReads, 1, "starving still eats");
+    await policy.edit({
+      operation: "set",
+      expected_revision: policy.snapshot().revision,
+      changes: { food: { reflex: "never" } },
+      lifetime: { kind: "session" },
+      reason: "test",
+    } as never);
+    bot.food = 2;
+    check();
+    assert.equal(foodReads, 1, "never leaves even starving to the player");
+  } finally {
+    await reflex[Symbol.asyncDispose]();
+    await driver[Symbol.asyncDispose]();
+  }
+});
