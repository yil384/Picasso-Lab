 }
+
+test("Patched for Muse plays Minecraft (picasso-lab), 0013: shield preparation waits for a short action of the player's", async () => {
+  const { deferShieldPreparation } = await import("./hostile.js");
+  const at = (action: string | null, owner = "foreground") => ({ owner, activeAction: action ? { action, startedAt: "" } : null });
+  assert.equal(deferShieldPreparation(at("craft_item")), true, "a craft finishes first (its temporary table back)");
+  assert.equal(deferShieldPreparation(at("equip")), true);
+  assert.equal(deferShieldPreparation(at("collect_block")), false, "a long walk or mine: the shield goes on at once");
+  assert.equal(deferShieldPreparation(at("navigate")), false);
+  assert.equal(deferShieldPreparation(at(null, "idle")), false, "an idle body: at once");
+  assert.equal(deferShieldPreparation(at("craft_item", "takeover")), false, "a reflex holds the body: not ours to defer");
+});
