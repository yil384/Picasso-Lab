0004: with MINEAI_HOST_TOKEN set, the host and its runtime answer only requests with Authorization: Bearer <token>.

diff --git a/src/server/host-token.ts b/src/server/host-token.ts
new file mode 100644
index 0000000..dbdf4c6
--- /dev/null
+++ b/src/server/host-token.ts
@@ -0,0 +1,30 @@
+/**
+ * Patched for Muse plays Minecraft (picasso-lab): when MINEAI_HOST_TOKEN is set,
+ * every HTTP request to the host and to its runtime must carry
+ * "Authorization: Bearer <token>". The token comes from the environment only,
+ * never the command line. Unset, nothing changes.
+ */
+import { timingSafeEqual } from "node:crypto";
+
+interface GateRequest {
+  readonly headers: { readonly authorization?: string | readonly string[] };
+}
+interface GateResponse {
+  status(code: number): { json(body: unknown): unknown };
+}
+
+export function hostTokenGate(token: string | undefined = process.env.MINEAI_HOST_TOKEN) {
+  const expected = token ? Buffer.from(`Bearer ${token}`) : null;
+  return (request: GateRequest, response: GateResponse, next: () => void) => {
+    if (!expected) {
+      next();
+      return;
+    }
+    const given = Buffer.from(String(request.headers.authorization ?? ""));
+    if (given.length === expected.length && timingSafeEqual(given, expected)) {
+      next();
+      return;
+    }
+    response.status(401).json({ error: "This Minecraft MCP host needs its token." });
+  };
+}
