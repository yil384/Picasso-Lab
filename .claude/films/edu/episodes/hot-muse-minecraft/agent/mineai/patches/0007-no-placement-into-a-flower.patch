+/**
+ * Patched for Muse plays Minecraft (picasso-lab): the server does not replace a
+ * flower with a placed block, so a temporary crafting table chosen on a poppy
+ * failed its craft ("block ... is still poppy"). Only what the server replaces
+ * is a site: air, the grasses and ferns, one layer of snow.
+ */
+test("a flower or deep snow is never a placement site; grass and one layer of snow are", () => {
+  for (const name of ["poppy", "dandelion", "cornflower", "lily_of_the_valley", "red_tulip", "torchflower", "oak_sapling", "sweet_berry_bush", "brown_mushroom", "sugar_cane"]) {
+    assert.equal(isReplaceableForPlacement(block(name)), false, name);
+    assert.equal(isDryPlacementSite(block(name)), false, name);
+  }
+  for (const name of ["air", "short_grass", "tall_grass", "fern", "dead_bush", "vine", "snow"]) {
+    assert.equal(isDryPlacementSite(block(name)), true, name);
+  }
+  const snow = (layers: number): ClassifiedBlock => ({ name: "snow", boundingBox: "empty", getProperties: () => ({ layers }) });
+  assert.equal(isDryPlacementSite(snow(1)), true);
+  assert.equal(isDryPlacementSite(snow(2)), false);
+  assert.equal(isDryPlacementSite(snow(7)), false);
+});
