+  const bot = { blockAt: (v: Vec3) => ({ name: portal.has(`${v.x},${v.y},${v.z}`) ? "nether_portal" : "air" }) } as unknown as Pick<Bot, "blockAt">;
+  assert.equal(inLitPortalFrame(bot, { x: 0, y: 66, z: 0 }), true, "a side of the frame");
