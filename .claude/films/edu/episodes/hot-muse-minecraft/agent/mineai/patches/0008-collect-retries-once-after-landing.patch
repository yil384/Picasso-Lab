+/**
+ * Patched for Muse plays Minecraft (picasso-lab): a collect that found no path
+ * within this long of a landing is tried once more, after the chunks around the
+ * bot have arrived. Staging, 8 games at once: `collect oak_log 6` failed 2.3 s
+ * after the bot was spread into one of 8 regions generating at once ("no path
+ * found ... visited 5097 nodes") and did not try another tree; the same spot
+ * alone passed.
+ */
+export const LANDING_RETRY_WINDOW_MS = 30_000;
+
+/** The routing stop of a path search that gave up (process-events: "no path found after ..."). */
+const NO_PATH = /\bno path found\b/;
+
+/** Whether a mine run is worth one more try: no path, nothing gained or broken, and a landing just before. */
+export function retryAfterLanding(result: MineResult, gained: number, landedAt: number | null, startedAt: number): boolean {
+  return (
+    (result.status === "unreachable" || result.status === "stopped") &&
+    NO_PATH.test(result.reason ?? "") &&
+    result.broken.length === 0 &&
+    gained === 0 &&
+    landedAt !== null &&
+    startedAt - landedAt <= LANDING_RETRY_WINDOW_MS
+  );
+}
+
+/** Run the mine process, and once more after `settle` when `retryAfterLanding` says so. */
+export async function mineAfterLanding(
+  run: () => Promise<MineResult>,
+  facts: {
+    readonly startedAt: number;
+    readonly landedAt: () => number | null;
+    readonly gained: () => number;
+    readonly settle: () => Promise<void>;
+  },
+): Promise<MineResult> {
+  const first = await run();
+  if (!retryAfterLanding(first, facts.gained(), facts.landedAt(), facts.startedAt)) return first;
+  await facts.settle();
+  const again = await run();
+  if (again.status !== "unreachable" && again.status !== "stopped") return again;
+  const reason = `${again.reason ?? "no route was found"} (tried once more after the chunks around the landing loaded)`;
+  return { ...again, reason };
+}
+
