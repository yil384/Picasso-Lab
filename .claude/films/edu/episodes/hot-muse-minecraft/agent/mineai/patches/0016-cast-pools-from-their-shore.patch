+import assert from "node:assert/strict";
+import test from "node:test";
+import { poolSourceOrder } from "./cast-targets.js";
+
+test("Patched for Muse plays Minecraft (picasso-lab), 0016: a lake's open shore sources first, then open ones, then those under lava", () => {
+  // a lake 4 wide at y 10: x 0..3, z 0; stone shore at x -1 and x 4; open air above except x 1, under more lava
+  const names = new Map<string, string>();
+  for (let x = 0; x <= 3; x += 1) names.set(`${x},10,0`, "lava");
+  names.set("1,11,0", "lava");
+  names.set("-1,10,0", "stone");
+  names.set("4,10,0", "stone");
+  for (const x of [0, 1, 2, 3]) for (const z of [-1, 1]) names.set(`${x},10,${z}`, "lava");
+  const nameAt = (x: number, y: number, z: number) => names.get(`${x},${y},${z}`) ?? (y >= 11 ? "air" : "stone");
+  const sources = [0, 1, 2, 3].map((x) => ({ x, y: 10, z: 0 }));
+  // the bot stands over x 2: the nearest source was x 2, in the middle with lava on both sides
+  const order = poolSourceOrder(sources, nameAt, { x: 2, y: 12, z: 0 });
+  assert.deepEqual(order.map((s) => s.x), [3, 0, 2, 1], "open and beside the shore (x 3, x 0), open (x 2), under lava (x 1)");
+});
