@@ -0,0 +1,62 @@
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import test from "node:test";
+import type { Bot } from "mineflayer";
+import { Vec3 } from "vec3";
+import { observeLandings, settleAfterLanding } from "./landing.js";
+
+/** Patched for Muse plays Minecraft (picasso-lab): a landing is a server move, not a correction. */
+function fakeBot() {
+  const bot = new EventEmitter() as EventEmitter & { entity: { position: Vec3 }; waitForChunksToLoad?: () => Promise<void> };
+  bot.entity = { position: new Vec3(0.5, 64, 0.5) };
+  return bot;
+}
+
+test("a spread or a teleport is a landing; a small correction is not", () => {
+  const bot = fakeBot();
+  let t = 1_000;
+  const clock = observeLandings(bot as unknown as Bot, () => t);
+  assert.equal(clock.landedAt(), null);
+  // what mineflayer does on a server move: send the new position back (`move`, with the old one), then `forcedMove`
+  const serverMove = (to: Vec3) => {
+    const from = bot.entity.position;
+    bot.entity.position = to;
+    bot.emit("move", from);
+    bot.emit("forcedMove");
+  };
+  bot.emit("move", new Vec3(0.5, 64, 0.4)); // a step of its own
+  t = 2_000;
+  serverMove(new Vec3(0.5, 64, 2.5)); // the server set the bot back two blocks
+  assert.equal(clock.landedAt(), null);
+  t = 3_000;
+  serverMove(new Vec3(-3825.5, 70, 761.5)); // spreadplayers
+  assert.equal(clock.landedAt(), 3_000);
+  t = 9_000;
+  serverMove(new Vec3(-3824.5, 70, 761.5));
+  assert.equal(clock.landedAt(), 3_000, "a correction after the landing keeps the landing's time");
+  t = 12_000;
+  serverMove(new Vec3(0.5, 64, 0.5)); // a respawn at the world spawn
+  assert.equal(clock.landedAt(), 12_000);
+  assert.equal(bot.listenerCount("forcedMove"), 1);
+  clock[Symbol.dispose]();
+  assert.equal(bot.listenerCount("forcedMove"), 0);
+  assert.equal(bot.listenerCount("move"), 0);
+});
+
+test("settling after a landing waits for the chunks and a pause, and a cancellation ends it", async () => {
+  const bot = fakeBot();
+  let waited = 0;
+  bot.waitForChunksToLoad = async () => {
+    waited += 1;
+  };
+  const t0 = Date.now();
+  await settleAfterLanding(bot as unknown as Bot, undefined, 30);
+  assert.equal(waited, 1);
+  assert.ok(Date.now() - t0 >= 25);
+  bot.waitForChunksToLoad = () => Promise.reject(new Error("Timeout waiting for 3 chunks to load after 10000ms"));
+  await settleAfterLanding(bot as unknown as Bot, undefined, 0);
+  bot.waitForChunksToLoad = () => new Promise(() => {});
+  const stop = new AbortController();
+  setTimeout(() => stop.abort(new Error("cancelled")), 20);
+  await assert.rejects(settleAfterLanding(bot as unknown as Bot, stop.signal, 10_000), /cancelled/);
+});
diff --git a/src/world/landing.ts b/src/world/landing.ts
new file mode 100644
index 0000000..6e13d94
--- /dev/null
+++ b/src/world/landing.ts
@@ -0,0 +1,64 @@
+/**
+ * Patched for Muse plays Minecraft (picasso-lab): when the bot last landed
+ * somewhere it did not walk to — the server moved it (`spreadplayers`, `/tp`, a
+ * respawn, a portal) farther than a correction would. Right after a landing the
+ * chunks around the new spot may still be arriving, and a path search there can
+ * see a closed region that is not closed (staging, 8 games at once: "no path
+ * found" 2.3 s after landing; the same spot alone passed).
+ */
+import type { Bot } from "mineflayer";
+import { setTimeout as delay } from "node:timers/promises";
+import type { Vec3 } from "vec3";
+
+/** A server move farther than this is a landing, not a correction of the bot's own step. */
+export const LANDING_DISTANCE = 16;
+/** After the chunks around a landing have arrived, a little longer for their neighbours and the light. */
+export const LANDING_SETTLE_PAUSE_MS = 2_000;
+
+export interface LandingClock {
+  /** When the bot last landed (ms since the epoch), or null if it has not since the clock started. */
+  readonly landedAt: () => number | null;
+}
+
+/**
+ * Watch one bot's landings; the runtime owns it and disposes of it with the
+ * bot's other listeners. Mineflayer answers a server move by sending the new
+ * position back, which emits `move` with where the bot was, then `forcedMove`.
+ */
+export function observeLandings(bot: Bot, now: () => number = Date.now): LandingClock & Disposable {
+  let landedAt: number | null = null;
+  let from: Vec3 | null = null;
+  const moved = (previous: Vec3) => {
+    from = previous;
+  };
+  const forced = () => {
+    if (from === null || from.distanceTo(bot.entity.position) > LANDING_DISTANCE) landedAt = now();
+    from = null;
+  };
+  bot.on("move", moved);
+  bot.on("forcedMove", forced);
+  return {
+    landedAt: () => landedAt,
+    [Symbol.dispose]() {
+      bot.off("move", moved);
+      bot.off("forcedMove", forced);
+    },
+  };
+}
+
+/**
+ * Wait for the ground around a fresh landing: the 5x5 chunks around the bot
+ * (mineflayer's own wait, at most its 10 s), then a short pause. Never throws
+ * for a slow server; only a cancellation ends it early.
+ */
+export async function settleAfterLanding(
+  bot: Bot,
+  signal?: AbortSignal,
+  pauseMs: number = LANDING_SETTLE_PAUSE_MS,
+): Promise<void> {
+  signal?.throwIfAborted();
+  const cancelled = new Promise<void>((resolve) => signal?.addEventListener("abort", () => resolve(), { once: true }));
+  await Promise.race([Promise.resolve(bot.waitForChunksToLoad?.()).catch(() => undefined), cancelled]);
+  signal?.throwIfAborted();
+  await delay(pauseMs, undefined, signal ? { signal } : undefined);
+}
