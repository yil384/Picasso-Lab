+  assert.equal(retryAfterLanding(noPath, 0, landed, landed + LANDING_RETRY_WINDOW_MS + 1), false, "long after the landing");
+  assert.equal(retryAfterLanding(noPath, 0, null, landed), false, "no landing seen");
+  assert.equal(retryAfterLanding(noPath, 1, landed, landed + 100), false, "something was gained");
+  assert.equal(retryAfterLanding({ ...noPath, broken: [{ x: 0, y: 64, z: 0 }] }, 0, landed, landed + 100), false, "a block was broken");
+  assert.equal(retryAfterLanding({ ...noPath, status: "unreachable" }, 0, landed, landed + 100), true);
+  assert.equal(retryAfterLanding({ ...noPath, status: "no_targets" }, 0, landed, landed + 100), false);
+  assert.equal(retryAfterLanding({ ...noPath, reason: "Pickaxe tier lost: stone_pickaxe broke." }, 0, landed, landed + 100), false, "a stop for another reason");
+  assert.equal(retryAfterLanding({ ...noPath, status: "unreachable", reason: "3 lava faces, 1 block carried" }, 0, landed, landed + 100), false);
