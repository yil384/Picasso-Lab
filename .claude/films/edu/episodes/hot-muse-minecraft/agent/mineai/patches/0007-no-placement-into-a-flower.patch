diff --git a/src/world/nearby-placement.test.ts b/src/world/nearby-placement.test.ts
new file mode 100644
index 0000000..85bd364
--- /dev/null
+++ b/src/world/nearby-placement.test.ts
@@ -0,0 +1,41 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { Bot } from "mineflayer";
+import { Vec3 } from "vec3";
+import { chooseCell } from "./nearby-placement.js";
+
+/**
+ * Patched for Muse plays Minecraft (picasso-lab). Staging, spot 7: the
+ * temporary crafting table was put into a poppy's cell, the server refused the
+ * placement ("block ... is still poppy") and the craft failed in 81 ms. On a
+ * grass floor with flowers in the nearest cells, the table goes to the nearest
+ * cell the server would fill, and with flowers everywhere to none at all.
+ */
+function meadow(cells: (position: Vec3) => string) {
+  return {
+    entity: { position: new Vec3(0.5, 64, 0.5) },
+    blockAt: (position: Vec3) => {
+      const name = position.y < 64 ? "grass_block" : position.y === 64 ? cells(position) : "air";
+      return { name, position, boundingBox: name === "grass_block" ? "block" : "empty" };
+    },
+  } as unknown as Bot;
+}
+
+test("a temporary table goes to the nearest clear cell, never into a flower's", () => {
+  const flowers = new Set(["1,0", "-1,0", "0,1", "0,-1"]);
+  const bot = meadow((p) => (flowers.has(`${p.x},${p.z}`) ? "poppy" : "air"));
+  const cell = chooseCell(bot, "crafting_table", 3);
+  assert.ok(cell, "a clear cell is found");
+  assert.equal(cell.position.y, 64);
+  assert.equal(flowers.has(`${cell.position.x},${cell.position.z}`), false);
+  assert.equal(cell.face.y, 1, "on the floor");
+  assert.ok(cell.position.distanceTo(new Vec3(0, 64, 0)) < 1.5, "the next nearest cell, a diagonal");
+});
+
+test("short grass is filled as before; flowers everywhere leave no cell", () => {
+  const grass = chooseCell(meadow(() => "short_grass"), "crafting_table", 3);
+  assert.ok(grass);
+  assert.equal(grass.position.distanceTo(new Vec3(0, 64, 0)), 1);
+  assert.equal(chooseCell(meadow(() => "poppy"), "crafting_table", 3), null);
+  assert.equal(chooseCell(meadow(() => "dandelion"), "furnace", 3), null);
+});
