# Copy to .env next to compose.yaml (README "Deploy"). The two secrets are not here: they are files in ./secrets
# (ops/secrets.sh makes them), so `docker inspect` never shows them.

# off | on  (turn on only after the Firebase console steps in README.md)
EMAIL_LINK=off
FIREBASE_PROJECT_ID=yichen-5e23e

# the page origin (GitHub Pages); comma-separated list
ALLOWED_ORIGINS=https://yil384.github.io

# who may say who the client is (X-Forwarded-For): the Caddy container, by its name on the shared network
TRUST_PROXY=fras-caddy-1

# the Docker network Caddy is on (compose joins it; nothing is published on the host)
HOLDEM_EDGE_NETWORK=fras_default

# the host folder that holds the data files (ops/datadir.sh makes it): on a disk with quick fsync, not /ssd2
HOLDEM_DATA_DIR=/home/yichen/workspace/holdem-dealer/data

# fixed inside the container; listed for completeness
PORT=8787
DATA_DIR=/data
