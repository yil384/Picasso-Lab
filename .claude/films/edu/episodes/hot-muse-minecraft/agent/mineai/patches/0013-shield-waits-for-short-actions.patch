 /** Hostile observations and execution; admission, cancellation and failure retention belong to the driver. */
+/**
+ * Patched for Muse plays Minecraft (picasso-lab), 0013: equipping a carried shield is a preparation, not a response
+ * to a threat, so it waits for a short foreground action of the player's to finish instead of taking the body over
+ * in the middle of it (a production game, 2026-10-11: a shield craft at night with two hostiles near was preempted
+ * right after the shield appeared, before its temporary crafting table was picked up again, and reported failed).
+ * Real threats are not affected: a contact or a directive still gets its response at once.
+ */
+export const SHIELD_WAITS_FOR = new Set(["craft_item", "smelt_item", "equip", "eat_food", "place_block", "drop_item", "use_container", "pick_up_items"]);
+export function deferShieldPreparation(status: { owner: string; activeAction: { action: string } | null }): boolean {
+  return status.owner === "foreground" && status.activeAction !== null && SHIELD_WAITS_FOR.has(status.activeAction.action);
+}
