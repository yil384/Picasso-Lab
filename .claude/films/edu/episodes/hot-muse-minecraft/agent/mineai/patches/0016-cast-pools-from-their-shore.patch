+/**
+ * Patched for Muse plays Minecraft (picasso-lab), 0016: a pool's sources in the order a cast can use them. A source
+ * with open air above it can be poured onto, one under more lava cannot; a source beside the shore has a stance near
+ * it, one in the middle of a lake has none within reach. So open sources beside the shore come first, then open ones,
+ * then the rest, nearest first within each. The route's goal takes the first few (POOL_GOAL_LIPS), which for a lake
+ * used to be the nearest ones, often under other lava or out in the middle with no stance near (the soak on staging,
+ * 2026-10-14: "no obsidian came in" three times at pools of 23 to 64 sources).
+ */
+export function poolSourceOrder(
+  sources: readonly BlockPosition[],
+  nameAt: (x: number, y: number, z: number) => string | null,
+  feet: { x: number; y: number; z: number },
+): BlockPosition[] {
+  const rank = (s: BlockPosition): number => {
+    const above = nameAt(s.x, s.y + 1, s.z);
+    const open = above !== null && above !== "lava" && above !== "water" && !isSolidName(above);
+    const shore = [[1, 0], [-1, 0], [0, 1], [0, -1]].some(([dx, dz]) => {
+      const beside = nameAt(s.x + dx, s.y, s.z + dz);
+      return beside !== null && beside !== "lava";
+    });
+    return open ? (shore ? 0 : 1) : 2;
+  };
+  const away = (s: BlockPosition) => (s.x - feet.x) ** 2 + (s.y - feet.y) ** 2 + (s.z - feet.z) ** 2;
+  return [...sources].map((s) => ({ s, r: rank(s), d: away(s) })).sort((a, b) => a.r - b.r || a.d - b.d).map(({ s }) => s);
+}
+/** A block a pour cannot pass through (anything but air, a liquid or the like); unknown names count as solid. */
+function isSolidName(name: string): boolean {
+  return !/^(air|cave_air|void_air|lava|water|short_grass|tall_grass|fern|large_fern|vine|glow_lichen|snow)$/.test(name);
+}
