applied to the pinned commit by mineai/fetch-and-patch.sh (or scripts/mineai-fetch.mjs); git apply skips these lines.
0005: the player name from MINEAI_USERNAME and the runtime's bootstrap through its environment, so a private player
name is never on a command line (every user of the machine can read those).

diff --git a/src/server/config.test.ts b/src/server/config.test.ts
index 5b8438a..cd723e1 100644
--- a/src/server/config.test.ts
+++ b/src/server/config.test.ts
@@ -47,3 +47,17 @@ test("rejects unknown bot-data choices at the host boundary", () => {
     /--bot-data-scope must be one of bot, shared/,
   );
 });
+
+// Patched for Muse plays Minecraft (picasso-lab): the player name from the environment.
+test("takes the player name from MINEAI_USERNAME unless --username gives one", () => {
+  const before = process.env.MINEAI_USERNAME;
+  process.env.MINEAI_USERNAME = "Private_name_1";
+  try {
+    assert.equal(parseHostOptions([]).username, "Private_name_1");
+    assert.equal(parseHostOptions(["--username", "Other"]).username, "Other");
+  } finally {
+    if (before === undefined) delete process.env.MINEAI_USERNAME;
+    else process.env.MINEAI_USERNAME = before;
+  }
+  assert.equal(parseHostOptions([]).username, before || "MineAI");
+});
