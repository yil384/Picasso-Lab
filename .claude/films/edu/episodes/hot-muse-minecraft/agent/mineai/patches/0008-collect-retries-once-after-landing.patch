+test("a collect that finds no path right after a landing is tried once more, and only then", async () => {
+  // what the staging game got: the route's own stop ("stopped"), or every target given up ("unreachable")
+  const noPath: MineResult = { status: "stopped", broken: [], reason: "no path found after 234 ms compute; visited 5097 nodes" };
+  const done: MineResult = { status: "satisfied", broken: [{ x: 1, y: 70, z: 2 }], reason: null };
