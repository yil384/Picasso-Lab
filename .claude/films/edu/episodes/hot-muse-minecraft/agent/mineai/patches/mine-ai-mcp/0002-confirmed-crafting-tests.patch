new file mode 100644
index 0000000..b19b242
--- /dev/null
+++ b/src/world/confirmed-craft.test.ts
@@ -0,0 +1,137 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { clickServerBot } from "../test-support/click-server.js";
+import { planCraftingFromInventory } from "../utils/craft-plan.js";
+import { gridOf } from "./confirmed-craft.js";
+import { canConfirmClicks, confirmedWindowTiming, planPut } from "./confirmed-window.js";
+import { executeCraftPlan } from "./crafting.js";
+
+function plan(bot: ReturnType<typeof clickServerBot>["bot"], targets: Record<string, number>) {
+  const preparation = planCraftingFromInventory(
+    bot,
+    Object.entries(targets).map(([name, count]) => {
+      const item = bot.registry.itemsByName[name]!;
+      return { id: item.id, name: item.name, count };
+    }),
+  );
+  assert.equal(preparation.kind, "ready");
+  return preparation.applications;
+}
+
+const carried = (bot: ReturnType<typeof clickServerBot>["bot"], name: string) =>
+  bot.inventory.items().reduce((sum, item) => sum + (item.name === name ? item.count : 0), 0);
+
+test("gridOf and planPut: shaped recipes land in their slots; a stack is picked up once and the rest goes back", () => {
+  const { bot } = clickServerBot({ carried: { oak_planks: 12 } });
+  const id = (name: string) => bot.registry.itemsByName[name]!.id;
+  const pickaxe = bot.recipesAll(id("wooden_pickaxe"), null, true).find((r) => r.inShape?.[0]?.[0]?.id === id("oak_planks"))!;
+  assert.deepEqual([...gridOf(pickaxe, 3)!], [
+    [id("oak_planks"), [1, 2, 3]],
+    [id("stick"), [5, 8]],
+  ]);
+  assert.equal(gridOf(pickaxe, 2), null, "a 3x3 recipe does not fit the 2x2 grid");
+  assert.deepEqual(planPut(bot.inventory, id("oak_planks"), [1, 2], 3), [
+    [9, 0, 0],
+    [1, 1, 0],
+    [1, 1, 0],
+    [1, 1, 0],
+    [2, 1, 0],
+    [2, 1, 0],
+    [2, 1, 0],
+    [9, 0, 0],
+  ]);
+  assert.equal(planPut(bot.inventory, id("oak_planks"), [1, 2, 3], 5), null, "15 needed, 12 carried");
+});
+
+test("Paper's result burst: logs to planks, sticks and a table in the 2x2 grid, exact counts on the server", async () => {
+  const fake = clickServerBot({ carried: { birch_log: 3 }, paper: true });
+  const { bot } = fake;
+  assert.equal(canConfirmClicks(bot), true);
+  for (const [target, count] of [
+    ["birch_planks", 12],
+    ["stick", 4],
+    ["crafting_table", 1],
+  ] as const) {
+    const result = await executeCraftPlan(bot, plan(bot, { [target]: count }), null);
+    assert.deepEqual(result, { kind: "completed", completedSteps: 1 }, target);
+  }
+  assert.ok(fake.emptyResultFlashes() > 0, "the server showed the result slot empty before filling it");
+  assert.equal(fake.serverCount("birch_log"), 0);
+  assert.equal(fake.serverCount("birch_planks"), 6, "12 made, 2 for the sticks, 4 for the table");
+  assert.equal(fake.serverCount("stick"), 4);
+  assert.equal(fake.serverCount("crafting_table"), 1);
+  assert.equal(carried(bot, "birch_planks"), 6, "the bot's view is the server's");
+  assert.equal(carried(bot, "stick"), 4);
+  assert.ok(fake.written.some((p) => p.name === "close_window" && p.packet.windowId === 0), "the 2x2 grid is closed");
+  assert.ok(fake.written.filter((p) => p.name === "window_click").every((p) => p.packet.stateId === -1));
+});
+
+test("a table plan with Paper's bursts: a wooden pickaxe and sticks crafted in one window, many batches at once", async () => {
+  const fake = clickServerBot({ carried: { oak_planks: 40 }, paper: true });
+  const { bot } = fake;
+  const applications = plan(bot, { wooden_pickaxe: 1, stick: 24 });
+  const result = await executeCraftPlan(bot, applications, fake.table as never);
+  assert.equal(result.kind, "completed");
+  assert.equal(fake.serverCount("wooden_pickaxe"), 1);
+  assert.equal(fake.serverCount("stick"), 26, "7 applications of 4 = 28 sticks, 2 used by the pickaxe");
+  assert.equal(fake.serverCount("oak_planks"), 40 - 3 - 14);
+  assert.equal(carried(bot, "stick"), 26);
+  assert.equal(bot.currentWindow, null, "the table window is closed");
+  const opens = fake.written.filter((p) => p.name === "close_window" && p.packet.windowId !== 0).length;
+  assert.equal(opens, 1, "one table window for the whole plan");
+});
+
+test("batches use the room a batch frees: two logs from a full inventory make eight planks in the freed slot", async () => {
+  const fake = clickServerBot({ carried: { cobblestone: 35 * 64, oak_log: 2 } });
+  const result = await executeCraftPlan(fake.bot, plan(fake.bot, { oak_planks: 8 }), null);
+  assert.deepEqual(result, { kind: "completed", completedSteps: 1 });
+  assert.equal(fake.serverCount("oak_planks"), 8);
+  assert.equal(fake.serverCount("oak_log"), 0);
+});
+
+test("a full inventory is refused before any click, with the inventory-room error", async () => {
+  // a full stack of logs: taking one frees no slot, so four planks have nowhere to go
+  const fake = clickServerBot({ carried: { cobblestone: 35 * 64, oak_log: 64 } });
+  const result = await executeCraftPlan(fake.bot, plan(fake.bot, { oak_planks: 4 }), null);
+  assert.equal(result.kind, "failed");
+  assert.match(String(result.kind === "failed" && result.cause), /needs inventory room to store 4 oak_planks/);
+  assert.equal(fake.serverCount("oak_log"), 64);
+  assert.equal(fake.written.filter((p) => p.name === "window_click" && p.packet.slot !== -999).length, 0);
+});
+
+test("a server that never answers fails within the settle limit instead of crafting on a guess", async () => {
+  const saved = confirmedWindowTiming.settleMs;
+  confirmedWindowTiming.settleMs = 200;
+  try {
+    const fake = clickServerBot({ carried: { oak_log: 1 }, deaf: true });
+    const result = await executeCraftPlan(fake.bot, plan(fake.bot, { oak_planks: 4 }), null);
+    assert.equal(result.kind, "failed");
+    assert.match(String(result.kind === "failed" && result.cause), /did not answer the window clicks in time/);
+  } finally {
+    confirmedWindowTiming.settleMs = saved;
+  }
+});
+
+test("a table that never opens fails after two tries", async () => {
+  const saved = confirmedWindowTiming.openMs;
+  confirmedWindowTiming.openMs = 100;
+  try {
+    const fake = clickServerBot({ carried: { oak_planks: 3, stick: 2 }, noOpen: true });
+    const result = await executeCraftPlan(fake.bot, plan(fake.bot, { wooden_pickaxe: 1 }), fake.table as never);
+    assert.equal(result.kind, "failed");
+    assert.match(String(result.kind === "failed" && result.cause), /crafting table did not open/);
+  } finally {
+    confirmedWindowTiming.openMs = saved;
+  }
+});
+
+test("cancellation stops the clicks and still hands the grid back", async () => {
+  const fake = clickServerBot({ carried: { oak_log: 8 }, lagMs: 20 });
+  const controller = new AbortController();
+  setTimeout(() => controller.abort(new Error("cancelled by the test")), 30);
+  await assert.rejects(executeCraftPlan(fake.bot, plan(fake.bot, { oak_planks: 32 }), null, controller.signal), /cancelled/);
+  await new Promise((resolve) => setTimeout(resolve, 100));
+  const planks = fake.serverCount("oak_planks");
+  assert.equal(fake.serverCount("oak_log") * 4 + planks, 32, "every log is either a log or four planks");
+  assert.ok(fake.written.some((p) => p.name === "close_window" && p.packet.windowId === 0));
+});
