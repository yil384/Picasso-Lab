+// Window clicks the server confirms. Ported from the "Muse plays Minecraft" agent (Picasso Lab, UC San Diego,
+// src/skills/window.js) for Paper servers.
+//
+// Mineflayer sends each click with the client's own prediction of the window and goes on. A 1.17.1+ server answers a
+// click whose state id is stale with a full window resync, and Paper also answers the click that completes or takes
+// a crafting result with a burst (the source slot, the result slot three times: empty, then the result, the grid
+// slot, then a full window resync, all within 0-2 ms). Those packets describe the window as it was a few clicks
+// earlier; applied over the client's prediction, the next click is decided on a stale window: the result slot is read
+// before it is filled, or a stick goes where a plank belongs.
+//
+// Here every sequence of clicks is planned from a window state the server has confirmed, sent as packets that carry
+// state id -1 (the server applies the click to its own state, then always answers with exactly one full resync), and
+// followed by a settle that waits until the answer to the last click is in, plus a short quiet spell. "Settled" is a
+// count, not a guess.
+import { createRequire } from "node:module";
+import type { Bot } from "mineflayer";
+import type { Item } from "prismarine-item";
+
+export type BotWindow = NonNullable<Bot["currentWindow"]> | Bot["inventory"];
+/** [slot, mouse button, mode]; mode 1 is a shift-click. */
+export type Click = readonly [slot: number, button: number, mode: number];
+
+/** How long the server gets to open a window, and to answer the clicks sent so far (tests shorten these). */
+export const confirmedWindowTiming = { openMs: 5_000, settleMs: 4_000 };
+/** Packets in a row before a short pause (Paper kicks a client that sends more than 500 packets a second). */
+const BURST = 24;
+const BURST_GAP_MS = 60;
+/** After the expected answers are in: a short quiet spell in which nothing more for this window arrives. */
+const QUIET_MS = 50;
+const POLL_MS = 20;
+
+type ItemLoader = (registry: Bot["registry"]) => typeof Item;
+const loadItem = createRequire(import.meta.url)("prismarine-item") as ItemLoader;
+
+interface Tracker {
+  /** Full resyncs (window_items) received per window id. */
+  readonly full: Map<number, number>;
+  /** When the server last touched each window id. */
+  readonly last: Map<number, number>;
+}
+
+const trackers = new WeakMap<Bot, Tracker>();
+
+/** True for a bot that talks to a 1.17.1+ server through minecraft-protocol, where state id -1 forces a resync. */
+export function canConfirmClicks(bot: Bot): boolean {
+  const client = (bot as Partial<Bot>)._client;
+  return (
+    typeof client?.write === "function" &&
+    typeof client.on === "function" &&
+    typeof bot.supportFeature === "function" &&
+    bot.supportFeature("stateIdUsed")
+  );
+}
+
+/** Per bot: how many full resyncs each window id has received and when the server last touched it. */
+export function windowTracker(bot: Bot): Tracker {
+  const known = trackers.get(bot);
+  if (known) return known;
+  const tracker: Tracker = { full: new Map(), last: new Map() };
+  const touch = (id: number): void => {
+    tracker.last.set(id, Date.now());
+  };
+  bot._client.on("window_items", (packet: { windowId: number }) => {
+    tracker.full.set(packet.windowId, (tracker.full.get(packet.windowId) ?? 0) + 1);
+    touch(packet.windowId);
+  });
+  bot._client.on("set_slot", (packet: { windowId: number }) => touch(packet.windowId));
+  bot._client.on("set_player_inventory", () => touch(0));
+  trackers.set(bot, tracker);
+  return tracker;
+}
+
+function pause(milliseconds: number, signal?: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    const timer = setTimeout(done, milliseconds);
+    const aborted = () => done(signal?.reason ?? new Error("Window clicks were cancelled."));
+    function done(cause?: unknown) {
+      clearTimeout(timer);
+      signal?.removeEventListener("abort", aborted);
+      if (cause !== undefined) reject(cause);
+      else resolve();
+    }
+    if (signal?.aborted) aborted();
+    else signal?.addEventListener("abort", aborted, { once: true });
+  });
+}
+
+const openWindow = (bot: Bot): BotWindow => bot.currentWindow ?? bot.inventory;
+
+/**
+ * A planned, confirmed click session on one window. `click` only sends; `settle` waits until the server has answered
+ * every click sent so far (and mineflayer's window shows the server's state).
+ */
+export class ConfirmedClicks {
+  readonly #bot: Bot;
+  readonly #tracker: Tracker;
+  readonly #empty: unknown;
+  readonly #signal?: AbortSignal;
+  #expect: number;
+  #sinceGap = 0;
+  #pending = false;
+
+  constructor(
+    bot: Bot,
+    readonly window: BotWindow,
+    signal?: AbortSignal,
+  ) {
+    this.#bot = bot;
+    this.#tracker = windowTracker(bot);
+    this.#empty = loadItem(bot.registry).toNotch(null);
+    this.#signal = signal;
+    this.#expect = this.#tracker.full.get(window.id) ?? 0;
+  }
+
+  async #send(slot: number, mouseButton: number, mode: number): Promise<void> {
+    this.#signal?.throwIfAborted();
+    if (this.window !== openWindow(this.#bot)) throw new Error("The window was closed.");
+    this.#bot._client.write("window_click", {
+      windowId: this.window.id,
+      stateId: -1,
+      slot,
+      mouseButton,
+      mode,
+      changedSlots: [],
+      cursorItem: this.#empty,
+    });
+    this.#expect += 1;
+    this.#pending = true;
+    if (++this.#sinceGap >= BURST) {
+      this.#sinceGap = 0;
+      await pause(BURST_GAP_MS, this.#signal);
+    }
+  }
+
+  /** Left (0) or right (1) click on a slot; mode 1 is a shift-click. */
+  click(slot: number, button = 0, mode = 0): Promise<void> {
+    return this.#send(slot, button, mode);
+  }
+
+  async clicks(list: readonly Click[]): Promise<void> {
+    for (const [slot, button, mode] of list) await this.#send(slot, button, mode);
+  }
+
+  /**
+   * Wait until the server has answered every click sent so far. With no click pending, ask for a resync (the end of
+   * a drag that never started changes nothing). Throws when the server stays silent for the settle limit.
+   */
+  async settle(timeoutMs = confirmedWindowTiming.settleMs): Promise<void> {
+    if (!this.#pending) await this.#send(-999, 2, 5);
+    this.#pending = false;
+    this.#sinceGap = 0;
+    const id = this.window.id;
+    const until = Date.now() + timeoutMs;
+    while ((this.#tracker.full.get(id) ?? 0) < this.#expect) {
+      if (Date.now() > until) throw new Error("The server did not answer the window clicks in time.");
+      if (this.window !== openWindow(this.#bot)) throw new Error("The window was closed.");
+      await pause(POLL_MS, this.#signal);
+    }
+    while (Date.now() - (this.#tracker.last.get(id) ?? 0) < QUIET_MS && Date.now() < until) {
+      await pause(QUIET_MS / 2, this.#signal);
+    }
+    this.#expect = Math.max(this.#expect, this.#tracker.full.get(id) ?? 0);
+  }
+}
+
+/**
+ * Close the player's own inventory screen as the vanilla client does: the server puts what is in the 2x2 grid and on
+ * the cursor back into the inventory (or drops it when the inventory is full). Mineflayer never sends this for window
+ * 0, so items left in the grid would stay where nothing counts them.
+ */
+export function closePlayerInventory(bot: Bot): void {
+  if (bot.currentWindow) return;
+  try {
+    bot._client.write("close_window", { windowId: 0 });
+  } catch {
+    return;
+  }
+  bot.inventory.selectedItem = null;
+}
+
+/**
+ * Wait until the player inventory shows what the server has (one resync of window 0 and a quiet spell after it).
+ * Never throws; false when a container is open or the server did not answer.
+ */
+export async function syncPlayerInventory(bot: Bot, timeoutMs = 1_500, signal?: AbortSignal): Promise<boolean> {
+  if (!canConfirmClicks(bot) || bot.currentWindow) return false;
+  try {
+    await new ConfirmedClicks(bot, bot.inventory, signal).settle(timeoutMs);
+    return true;
+  } catch {
+    signal?.throwIfAborted();
+    return false;
+  }
+}
+
+/**
+ * Open the window of a block (crafting table): face it, use it, and wait for the window with a time limit. One more
+ * try after a short pause (a block placed a moment ago).
+ */
+export async function openBlockWindow(
+  bot: Bot,
+  block: Parameters<Bot["activateBlock"]>[0],
+  typePrefix: string,
+  what: string,
+  signal?: AbortSignal,
+): Promise<NonNullable<Bot["currentWindow"]>> {
+  windowTracker(bot);
+  if (bot.currentWindow) bot.closeWindow(bot.currentWindow);
+  for (let attempt = 1; ; attempt += 1) {
+    signal?.throwIfAborted();
+    try {
+      // facing the block first means activateBlock has nothing left to turn before it uses the block
+      await bot.lookAt(block.position.offset(0.5, 0.5, 0.5), true);
+      const ms = confirmedWindowTiming.openMs;
+      const window = await new Promise<NonNullable<Bot["currentWindow"]>>((resolve, reject) => {
+        const timer = setTimeout(() => finish(new Error(`The ${what} did not open within ${ms / 1000} s.`)), ms);
+        const aborted = () => finish(signal?.reason ?? new Error(`Opening the ${what} was cancelled.`));
+        const opened = (window: NonNullable<Bot["currentWindow"]>) => finish(undefined, window);
+        function finish(cause?: unknown, window?: NonNullable<Bot["currentWindow"]>) {
+          clearTimeout(timer);
+          bot.removeListener("windowOpen", opened);
+          signal?.removeEventListener("abort", aborted);
+          if (window) resolve(window);
+          else reject(cause);
+        }
+        bot.on("windowOpen", opened);
+        signal?.addEventListener("abort", aborted, { once: true });
+        Promise.resolve()
+          .then(() => bot.activateBlock(block))
+          .catch(() => undefined);
+      });
+      if (!String(window.type).startsWith(typePrefix)) {
+        bot.closeWindow(window);
+        throw new Error(`That block opened a ${String(window.type)} window, not a ${what}.`);
+      }
+      return window;
+    } catch (cause) {
+      signal?.throwIfAborted();
+      if (attempt >= 2 || /opened a/.test(String(cause))) throw cause;
+      await pause(300, signal);
+    }
+  }
+}
+
+/** Inventory slots of a window (main + hotbar) holding an item id, fullest first. */
+export function stacksOf(window: BotWindow, id: number): { slot: number; count: number }[] {
+  const out: { slot: number; count: number }[] = [];
+  for (let slot = window.inventoryStart; slot < window.inventoryEnd; slot++) {
+    const item = window.slots[slot];
+    if (item && item.type === id) out.push({ slot, count: item.count });
+  }
+  return out.sort((a, b) => b.count - a.count);
+}
+
+/** How many of an item id the window's inventory part holds, plus the cursor. */
+export function countIn(window: BotWindow, id: number): number {
+  let count = window.selectedItem?.type === id ? window.selectedItem.count : 0;
+  for (let slot = window.inventoryStart; slot < window.inventoryEnd; slot++) {
+    const item = window.slots[slot];
+    if (item && item.type === id) count += item.count;
+  }
+  return count;
+}
+
+/** The first empty slot of the window's inventory part, or null. */
+export function emptySlotIn(window: BotWindow): number | null {
+  for (let slot = window.inventoryStart; slot < window.inventoryEnd; slot++) if (!window.slots[slot]) return slot;
+  return null;
+}
+
+/**
+ * Clicks that put `perSlot` of item `id` into each of `destinations`, taken from the inventory stacks (fullest first):
+ * pick a stack up, right-click one at a time into each destination (or one left click when everything held goes
+ * there), and put what is left back into the slot it came from. Planned on a settled window. Null when the inventory
+ * does not hold enough.
+ */
+export function planPut(window: BotWindow, id: number, destinations: readonly number[], perSlot: number): Click[] | null {
+  const stacks = stacksOf(window, id);
+  if (stacks.reduce((sum, stack) => sum + stack.count, 0) < destinations.length * perSlot) return null;
+  const out: Click[] = [];
+  let held = 0;
+  let from: { slot: number; count: number } | undefined;
+  let next = 0;
+  for (const destination of destinations) {
+    let want = perSlot;
+    while (want > 0) {
+      if (held === 0) {
+        from = stacks[next++]!;
+        out.push([from.slot, 0, 0]);
+        held = from.count;
+      }
+      const put = Math.min(want, held);
+      if (put === held && put > 1) out.push([destination, 0, 0]);
+      else for (let i = 0; i < put; i++) out.push([destination, 1, 0]);
+      held -= put;
+      want -= put;
+    }
+  }
+  if (held > 0 && from) out.push([from.slot, 0, 0]);
+  return out;
+}
