# The live-video streamer for play.picasso-lab.com (compose profile "stream"): Playwright's headless Chromium shell
# (it carries SwiftShader, so WebGL renders on the CPU) and ffmpeg, driven by `scripts/stream.mjs --serve`. It shares
# the agent's network namespace (compose: network_mode service:agent), so the agent's first-person views on 127.0.0.1
# are local to it and its control API is reachable only from the agent. Build context: agent/.
FROM node:22-bookworm-slim
WORKDIR /app
# ffmpeg: libx264 + aac + rtmps (Debian's build); fonts for the caption; procps for ps (the stream's CPU and RAM numbers)
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
# the same headless shell build as the one measured (Playwright 1.63 = Chrome for Testing 153), with its system libraries
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx -y playwright@1.63.0 install --with-deps chromium-headless-shell \
 && rm -rf /root/.npm /var/lib/apt/lists/*
COPY src ./src
COPY scripts ./scripts
# Chromium's own sandbox needs user namespaces, which Docker's default seccomp profile refuses: the container is the
# sandbox (it renders only our own view pages; capped in compose.yaml)
ENV LOG_DIR=/logs NODE_ENV=production STREAM_NO_SANDBOX=1 STREAM_SERVICE_PORT=7861
CMD ["node", "scripts/stream.mjs", "--serve"]
