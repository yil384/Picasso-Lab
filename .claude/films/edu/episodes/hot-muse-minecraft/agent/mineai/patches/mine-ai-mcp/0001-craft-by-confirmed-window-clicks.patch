+// Crafting by confirmed window clicks (see confirmed-window.ts). Ported from the "Muse plays Minecraft" agent (Picasso
+// Lab, UC San Diego, src/skills/craft.js). Mineflayer's craft() reads the result slot as soon as its click
+// resolves and keeps predicting the cursor through Paper's resync bursts; on Paper 1.21.4 that fails most 2x2 crafts
+// ("Server did not supply the expected crafting result") and puts sticks where planks belong at a table.
+//
+// One batch of k applications: put k of each ingredient in its grid slots, settle, check that the server shows the
+// recipe's result, shift-click it (the server crafts while the grid holds a full set), settle, and count what arrived.
+// Anything left in the grid (remainders, or what a full inventory refused) goes back into the inventory. Every step is
+// planned on a window the server has confirmed.
+import type { Bot } from "mineflayer";
+import type { CraftApplication } from "../utils/craft-plan.js";
+import {
+  ConfirmedClicks,
+  closePlayerInventory,
+  countIn,
+  emptySlotIn,
+  openBlockWindow,
+  planPut,
+  syncPlayerInventory,
+  type BotWindow,
+  type Click,
+} from "./confirmed-window.js";
+
+type Recipe = CraftApplication["recipe"];
+type RecipeItem = NonNullable<Recipe["ingredients"]>[number];
+type CraftingTable = Parameters<Bot["activateBlock"]>[0];
+
+const present = (item: RecipeItem | null | undefined): item is RecipeItem => item != null && item.id != null && item.id !== -1;
+
+/** Grid slots per ingredient id for a recipe in a w x w grid (slot 1 is the top left), or null if it does not fit. */
+export function gridOf(recipe: Pick<Recipe, "inShape" | "ingredients">, width: number): Map<number, number[]> | null {
+  const out = new Map<number, number[]>();
+  const add = (id: number, slot: number) => out.set(id, [...(out.get(id) ?? []), slot]);
+  if (recipe.inShape && recipe.inShape.length > 0) {
+    if (recipe.inShape.length > width || recipe.inShape.some((row) => row.length > width)) return null;
+    recipe.inShape.forEach((row, y) =>
+      row.forEach((ingredient, x) => {
+        if (present(ingredient)) add(ingredient.id, 1 + x + width * y);
+      }),
+    );
+  } else {
+    const list = (recipe.ingredients ?? []).filter(present);
+    if (list.length > width * width) return null;
+    list.forEach((ingredient, index) => add(ingredient.id, 1 + index));
+  }
+  return out.size > 0 ? out : null;
+}
+
+/** Remainders a recipe leaves in the grid per application (returned containers): id -> count. */
+function remaindersOf(recipe: Recipe): Map<number, number> {
+  const out = new Map<number, number>();
+  for (const row of recipe.outShape ?? [])
+    for (const item of row) if (present(item) && item.count > 0) out.set(item.id, (out.get(item.id) ?? 0) + item.count);
+  return out;
+}
+
+/**
+ * Would k applications fit? Takes the ingredients from the inventory stacks the way planPut does (fullest first),
+ * then stores k results and the remainders as the server does (into matching stacks first, then empty slots).
+ */
+function fits(bot: Bot, window: BotWindow, recipe: Recipe, grid: Map<number, number[]>, k: number): boolean {
+  const slots: ({ type: number; count: number } | null)[] = [];
+  for (let slot = window.inventoryStart; slot < window.inventoryEnd; slot++) {
+    const item = window.slots[slot];
+    slots.push(item ? { type: item.type, count: item.count } : null);
+  }
+  for (const [id, destinations] of grid) {
+    let need = destinations.length * k;
+    const stacks = slots
+      .map((stack, index) => ({ stack, index }))
+      .filter((entry): entry is { stack: { type: number; count: number }; index: number } => entry.stack?.type === id)
+      .sort((a, b) => b.stack.count - a.stack.count);
+    for (const { stack, index } of stacks) {
+      if (need === 0) break;
+      const take = Math.min(need, stack.count);
+      stack.count -= take;
+      need -= take;
+      if (stack.count === 0) slots[index] = null;
+    }
+    if (need > 0) return false;
+  }
+  const store = (id: number, count: number): boolean => {
+    const stackSize = bot.registry.items[id]?.stackSize ?? 64;
+    for (const stack of slots) {
+      if (count === 0) break;
+      if (stack && stack.type === id && stack.count < stackSize) {
+        const moved = Math.min(count, stackSize - stack.count);
+        stack.count += moved;
+        count -= moved;
+      }
+    }
+    for (let index = 0; index < slots.length && count > 0; index++) {
+      if (slots[index]) continue;
+      const moved = Math.min(count, stackSize);
+      slots[index] = { type: id, count: moved };
+      count -= moved;
+    }
+    return count === 0;
+  };
+  if (!store(recipe.result.id, recipe.result.count * k)) return false;
+  for (const [id, count] of remaindersOf(recipe)) if (!store(id, count * k)) return false;
+  return true;
+}
+
+const itemName = (bot: Bot, id: number | undefined) => (id == null ? "nothing" : (bot.registry.items[id]?.name ?? String(id)));
+
+/** A crafting window (a table's, or the player's own 2x2 grid) open for a run of confirmed batches. */
+export class ConfirmedCraftingSession {
+  readonly #bot: Bot;
+  readonly #window: BotWindow;
+  readonly #clicks: ConfirmedClicks;
+  readonly #width: number;
+  readonly #table: boolean;
+  readonly #signal?: AbortSignal;
+  #closed = false;
+
+  private constructor(bot: Bot, window: BotWindow, table: boolean, signal?: AbortSignal) {
+    this.#bot = bot;
+    this.#window = window;
+    this.#table = table;
+    this.#width = table ? 3 : 2;
+    this.#signal = signal;
+    this.#clicks = new ConfirmedClicks(bot, window, signal);
+  }
+
+  /** Open the table's window, or use the player's own 2x2 grid; the window is settled before the first click. */
+  static async open(bot: Bot, table: CraftingTable | null, signal?: AbortSignal): Promise<ConfirmedCraftingSession> {
+    if (table) {
+      const window = await openBlockWindow(bot, table, "minecraft:crafting", "crafting table", signal);
+      return new ConfirmedCraftingSession(bot, window, true, signal);
+    }
+    if (bot.currentWindow) bot.closeWindow(bot.currentWindow);
+    return new ConfirmedCraftingSession(bot, bot.inventory, false, signal);
+  }
+
+  /** Craft `applications` applications of one recipe in batches; throws with what the server showed on a failure. */
+  async craft(recipe: Recipe, applications: number): Promise<void> {
+    const bot = this.#bot;
+    const window = this.#window;
+    const resultName = itemName(bot, recipe.result.id);
+    const grid = gridOf(recipe, this.#width);
+    if (!grid) throw new Error(`The ${resultName} recipe does not fit a ${this.#width}x${this.#width} grid.`);
+    const perSlot = Math.min(64, ...[...grid.keys()].map((id) => bot.registry.items[id]?.stackSize ?? 64));
+    await this.#clicks.settle();
+    await this.#clearGrid();
+    let left = applications;
+    while (left > 0) {
+      this.#signal?.throwIfAborted();
+      let k = Math.min(left, perSlot);
+      while (k > 0 && !fits(bot, window, recipe, grid, k)) k -= 1;
+      if (k === 0) {
+        for (const [id, destinations] of grid)
+          if (countIn(window, id) < destinations.length)
+            throw new Error(`Missing ingredient ${itemName(bot, id)} for ${resultName}.`);
+        throw new Error(
+          `This crafting execution needs inventory room to store ${recipe.result.count} ${resultName} before the next recipe application.`,
+        );
+      }
+      const plan: Click[] = [];
+      for (const [id, destinations] of grid) {
+        const clicks = planPut(window, id, destinations, k);
+        if (!clicks) throw new Error(`Missing ingredient ${itemName(bot, id)} for ${resultName}.`);
+        plan.push(...clicks);
+      }
+      await this.#clicks.clicks(plan);
+      await this.#clicks.settle();
+      const shown = window.slots[0];
+      if (!shown || shown.type !== recipe.result.id) {
+        await this.#clearGrid();
+        throw new Error(`The server shows ${itemName(bot, shown?.type)} for this arrangement, not ${resultName}.`);
+      }
+      const before = countIn(window, recipe.result.id);
+      await this.#clicks.click(0, 0, 1);
+      await this.#clicks.settle();
+      const got = countIn(window, recipe.result.id) - before;
+      await this.#clearGrid();
+      if (got < k * recipe.result.count) {
+        throw new Error(
+          got <= 0
+            ? `The server did not hand over the ${resultName} result.`
+            : `The server made only ${got} of ${k * recipe.result.count} ${resultName}.`,
+        );
+      }
+      left -= k;
+    }
+  }
+
+  /** Put the cursor and the grid back into the inventory part of the window; throws when something does not fit. */
+  async #clearGrid(): Promise<void> {
+    const window = this.#window;
+    if (window.selectedItem) {
+      const slot = emptySlotIn(window);
+      if (slot === null) throw new Error("The cursor holds an item and the inventory has no room for it.");
+      await this.#clicks.click(slot, 0, 0);
+      await this.#clicks.settle();
+    }
+    const busy: Click[] = [];
+    for (let slot = 1; slot <= this.#width * this.#width; slot++) if (window.slots[slot]) busy.push([slot, 0, 1]);
+    if (busy.length === 0) return;
+    await this.#clicks.clicks(busy);
+    await this.#clicks.settle();
+    for (let slot = 1; slot <= this.#width * this.#width; slot++)
+      if (window.slots[slot]) throw new Error("The crafting grid holds items that do not fit back into the inventory.");
+  }
+
+  /**
+   * Close the window (the server hands back anything left in the grid and on the cursor) and wait until the player
+   * inventory shows the server's state. Safe to call twice.
+   */
+  async close(): Promise<void> {
+    if (this.#closed) return;
+    this.#closed = true;
+    const bot = this.#bot;
+    if (this.#table) {
+      try {
+        if (bot.currentWindow === this.#window) bot.closeWindow(this.#window as NonNullable<Bot["currentWindow"]>);
+      } catch {
+        // already closed
+      }
+    } else {
+      closePlayerInventory(bot);
+    }
+    await syncPlayerInventory(bot);
+  }
+}
+
+/** Craft every application of a plan through confirmed clicks, in one window. Throws on the first failure. */
+export async function craftConfirmed(
+  bot: Bot,
+  applications: readonly CraftApplication[],
+  table: CraftingTable | null,
+  signal?: AbortSignal,
+  onStep?: () => void,
+): Promise<void> {
+  const session = await ConfirmedCraftingSession.open(bot, table, signal);
+  try {
+    for (const application of applications) {
+      await session.craft(application.recipe, application.applications);
+      onStep?.();
+    }
+  } finally {
+    await session.close();
+  }
+}
